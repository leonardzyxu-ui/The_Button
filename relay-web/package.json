{
  "name": "the-button-relay-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 web",
    "dev:server": "npm run build:web && PORT=8787 node server/render-server.js",
    "start": "node server/render-server.js",
    "build:web": "vite build web",
    "build": "npm run build:web",
